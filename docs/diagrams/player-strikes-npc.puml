@startuml player-strikes-npc
title Player strikes an NPC

left to right direction
skinparam componentStyle rectangle
skinparam linetype polyline
skinparam defaultTextAlignment center
skinparam ArrowFontSize 11
skinparam PortFontSize 10
skinparam nodesep 25
skinparam ranksep 70
skinparam HexagonBorderColor #8A6D00
skinparam HexagonBorderThickness 2
skinparam component {
  BackgroundColor<<usecase>> #E3F2FD
  BorderColor<<usecase>> #1565C0
  BackgroundColor<<primary>> #E8F5E9
  BorderColor<<primary>> #2E7D32
  BackgroundColor<<secondary>> #FCE4EC
  BorderColor<<secondary>> #AD1457
}

component "ConsoleSession\n<size:10>JLine input loop — player actor</size>" as console <<primary>>

hexagon "core" as hex #FFFBE6 {
  portin "FightNpcInputPort" as fightIn
  component "FightNpcUseCase\n<size:10>playerHitsTarget</size>\n<size:10>(player as primary actor)</size>" as fight <<usecase>>
  portout "NpcRepositoryOperationsOutputPort" as npcRepoOut
}

component "SpringNpcRepositoryAdapter" as npcRepo <<secondary>>
database "PostgreSQL\n<size:10>npc row =</size>\n<size:10>the shared state</size>" as db

console -[#1565C0,bold]-> fightIn : <color:#1565C0>a. "hit goblin": playerHitsTarget(target)
fightIn -[#1565C0,bold]-> fight
fight -[#1565C0,bold]-> npcRepoOut
npcRepoOut -[#1565C0,bold]-> npcRepo : <color:#1565C0>b. saveNpc(provoked)
npcRepo -[#1565C0,bold]-> db : <color:#1565C0>c. NPC row: hit points lowered, hostile stance

@enduml
